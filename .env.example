# domain where you host this application, must be https
ISSUER_ORIGIN=https://your-issuer-url.example.com

# sandbox or production
AIR_ENV=sandbox

# optional DB
DATABASE_URL=postgres://postgres:postgres@127.0.0.1/issuer-backend

PARTNER_ID=PARNTER_ID

# can be generated with ./bin/generate-secrets
SEED=
PARTNER_PRIVATE_KEY_KID=
PARTNER_PRIVATE_KEY_DER=
API_KEY=secret
ADMIN_API_KEY=admin-secret
